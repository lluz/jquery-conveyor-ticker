{
  "name": "jquery-conveyor-ticker",
  "version": "1.2.0",
  "description": "jConveyorTicker - jQuery plugin to create simple horizontal conveyor belt animated tickers.",
  "author": "Copyright (c) 2017-2026 Luis Luz - UXD Lda <dev@uxd.pt>",
  "license": "MIT",
  "keywords": [
    "jquery-plugin",
    "ecosystem:jquery"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:lluz/jquery-conveyor-ticker.git"
  },
  "homepage": "https://github.com/lluz/jquery-conveyor-ticker",
  "bugs": {
    "url": "https://github.com/lluz/jquery-conveyor-ticker/issues"
  },
  "main": "dist/js/jquery.jConveyorTicker.js",
  "files": [
    "dist/js/jquery.jConveyorTicker.js"
  ],
  "devDependencies": {
    "adm-zip": "^0.6.0",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.0",
    "serve": "^14.2.4"
  },
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "esbuild dist/js/jquery.jConveyorTicker.js --minify --legal-comments=inline --outfile=dist/js/jquery.jConveyorTicker.min.js",
    "build:css": "esbuild dist/css/jquery.jConveyorTicker.css --minify --outfile=dist/css/jquery.jConveyorTicker.min.css",
    "dev_start": "concurrently \"npm run build:js -- --watch\" \"npm run build:css -- --watch\"",
    "server_start": "concurrently \"npm run dev_start\" \"serve dist -l 7777 --no-clipboard\"",
    "compress_dist": "node scripts/compress-dist.mjs"
  }
}
